# CampusPulse AI — Environment Configuration
# Copy this file to .env and fill in values

# Model Paths (relative to project root)
NLP_MODEL_PATH=models/nlp/distilbert_absa
VISION_MODEL_PATH=models/vision/mobilenetv2_defect.pt

# App Settings
APP_TITLE=CampusPulse AI
ADMIN_PASSWORD=admin123
LOG_LEVEL=INFO

# Feature Flags
USE_MOCK_MODELS=true   # Set to false when real model weights are present
ENABLE_GPU=false
